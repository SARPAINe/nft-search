# Backend configuration.
# Copy this file to `backend/.env` and fill in the secrets.
# This file is for LOCAL development (`npm run dev` against your local
# Postgres). The Docker stack does NOT read this file — it gets its
# config from `docker-compose.yml` inline defaults / shell environment.

# --- Runtime ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Points at a Postgres running on your host machine.
# If your local password differs, edit it here.
DATABASE_URL=postgresql://nftuser:CHANGE_ME@localhost:5432/nftmarket?schema=public

# --- Auth ---
# JWT_SECRET must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars

# API_KEY gates admin endpoints (bulk import, delete, dev-token mint).
# At least 16 characters. Generate one the same way as JWT_SECRET.
API_KEY=replace-me-with-a-long-random-api-key

# --- CORS ---
# Comma-separated allowlist of origins permitted to call this API.
CORS_ORIGINS=http://localhost:5173
