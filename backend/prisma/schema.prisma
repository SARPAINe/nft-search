// Prisma schema — used for typed CRUD on standard columns only.
// The search_vector column is GENERATED ALWAYS in SQL (see migrations/001_initial.sql)
// and is marked Unsupported here so Prisma ignores it on writes.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7+ — connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

model Nft {
  id               BigInt   @id @default(autoincrement())
  token_id         String
  contract_address String
  name             String
  description      String?
  creator_address  String
  owner_address    String
  collection_name  String
  traits           Json     @default("{}")
  price_eth        Decimal? @db.Decimal(20, 8)
  is_listed        Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)

  // GENERATED ALWAYS AS STORED — handled in raw SQL migration.
  search_vector Unsupported("tsvector")?

  @@unique([contract_address, token_id], name: "contract_token_unique")
  @@index([collection_name])
  @@map("nfts")
}
